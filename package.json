{
  "name": "maple",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agentic IDE for running Jira cards with Claude",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run --project node --project web",
    "test:socket": "vitest run --project socket",
    "test:live": "vitest run --project live",
    "e2e": "playwright test",
    "postinstall": "install-electron && electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "electron-log": "5.4.4",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "dev.tahardi.maple",
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "dir",
      "category": "Development",
      "icon": "resources/maple.png"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
