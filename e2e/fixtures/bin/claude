#!/usr/bin/env node
import { createInterface } from 'node:readline';

const args = process.argv.slice(2);
const shown = [`FAKE CLAUDE ${args.join(' ')}\r\n`];
process.stdout.write(shown[0]);
if (args[0] === '--version') {
  process.exit(0);
}
process.stdout.on('resize', () => {
  process.stdout.write(`\x1b[2J\x1b[H${shown.join('')}`);
});
createInterface({ input: process.stdin })
  .on('line', (line) => {
    shown.push(`${line}\r\n`);
    process.stdout.write(`${line}\r\n`);
  })
  .on('close', () => {
    process.exit(0);
  });
